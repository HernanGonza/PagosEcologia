{
  "name": "botonera-pagos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node scripts/dev.mjs api",
    "dev:relevamiento": "npm run dev -w @botonera/relevamiento",
    "dev:web": "node scripts/dev.mjs web",
    "build": "npm run build -w @botonera/web && npm run build -w @botonera/admin && npm run build -w @botonera/paneles && npm run build -w @botonera/api",
    "migrate": "npm run migrate -w @botonera/api",
    "clave-botonera": "npm run clave-botonera -w @botonera/api",
    "fitosanitarios:tareas": "npm run fitosanitarios:tareas -w @botonera/api",
    "dev:admin": "node scripts/dev.mjs admin",
    "dev:paneles": "node scripts/dev.mjs paneles",
    "dev": "node scripts/dev.mjs",
    "db:local": "node scripts/db-local.mjs"
  }
}
