# .env del SERVIDOR (VM de ecodatos). Copiar a .env y completar. No commitear el .env real.
# Qué archivos compose se usan (mismo mecanismo que la wiki): `docker compose up -d --build` los toma solos.
COMPOSE_FILE=docker-compose.yml:docker-compose.prueba.yml:docker-compose.ecodatos.yml

# Dirección pública de la botonera: los mails y el QR de los certificados apuntan acá (con la ruta, sin barra final).
WEB_URL=https://ecodatos.ecologia.misiones.gob.ar/pagos/publico

# Cantidad de proxies delante de la API: HAProxy + nginx de ecodatos + nginx de pagos = 3 (verificar).
TRUST_PROXY=3

# Base de Ecodatos (rol botonera) y Supabase: ver .env.example.
DATABASE_URL=postgresql://botonera.<tenant>:CAMBIAR@10.0.0.231:5432/postgres?sslmode=disable
SUPABASE_URL=https://ecodatos.ecologia.misiones.gob.ar
SUPABASE_INTERNAL_URL=http://10.0.0.231:8000
SUPABASE_SERVICE_ROLE_KEY=CAMBIAR
SUPABASE_ANON_KEY=CAMBIAR
# Se queman en los fronts al construir la imagen:
VITE_SUPABASE_URL=https://ecodatos.ecologia.misiones.gob.ar
VITE_SUPABASE_ANON_KEY=CAMBIAR
VERIFICACION_SECRETO=CAMBIAR   # openssl rand -base64 48

# Bandeja de mails (/pagos/mail/): si se define, la pantalla pide esta clave.
# MAIL_PANEL_CLAVE=

# NO definir: AUTH_LOCAL, ADMIN_SIN_LOGIN, STORAGE_LOCAL_DIR. El modo prueba (docker-compose.prueba.yml) ya fija
# NODE_ENV=staging, PAYMENT_PROVIDER=mock, EMISION_SIMULADA=1 y MAIL_PROVIDER=consola.
