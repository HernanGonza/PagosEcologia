# Supabase self-hosted de Ecodatos (10.0.0.231), vía pooler Supavisor en modo session (5432).
# El usuario va en formato multi-tenant: <rol>.<tenant>. Pedir credenciales al dueño del proyecto.
# Migraciones (npm run migrate): rol postgres.
MIGRATIONS_DATABASE_URL=postgresql://postgres.<tenant>:CAMBIAR@10.0.0.231:5432/postgres?sslmode=disable
# API: rol propio botonera (ver db/migrations/0003_rol_botonera.sql).
DATABASE_URL=postgresql://botonera.<tenant>:CAMBIAR@10.0.0.231:5432/postgres?sslmode=disable
PORT=3001
# mock | macroclick
PAYMENT_PROVIDER=mock
# Panel de Recaudaciones sin login: SOLO en desarrollo local, hasta que exista el login.
ADMIN_SIN_LOGIN=false

# --- Supabase de Ecodatos (Storage y Auth) ---
# URL pública. Si la API corre en la misma red que el servidor, SUPABASE_INTERNAL_URL evita salir por internet.
SUPABASE_URL=https://ecodatos.ecologia.misiones.gob.ar
# SUPABASE_INTERNAL_URL=http://10.0.0.231:8000
# Service role: SOLO en la API (sube y firma los documentos del bucket privado). Nunca en un front.
SUPABASE_SERVICE_ROLE_KEY=CAMBIAR
# Anon key (pública): la API la usa para validar las sesiones de los paneles.
SUPABASE_ANON_KEY=CAMBIAR
# Paneles de área (apps/paneles): login con el usuario de Ecodatos.
VITE_SUPABASE_URL=https://ecodatos.ecologia.misiones.gob.ar
VITE_SUPABASE_ANON_KEY=CAMBIAR

# --- Solicitudes con revisión técnica ---
# Secreto para firmar los códigos de verificación (mín. 32 caracteres): openssl rand -base64 48
# Obligatorio en producción (NODE_ENV=production): sin él la API no arranca.
VERIFICACION_SECRETO=CAMBIAR
# Enlaces de un solo uso y sesiones, en minutos (ver README-mails-y-seguridad.md). Valores por defecto:
# ENLACE_RECUPERAR_MINUTOS=15      # plazo para abrir el enlace del mail de "recuperar"
# ENLACE_AVISO_MINUTOS=43200       # plazo para abrir el enlace de un aviso del panel (30 días)
# SESION_INACTIVIDAD_MINUTOS=30    # la sesión se cierra tras tanto sin usarla
# SESION_MAXIMO_MINUTOS=240        # ...y a las 4 horas de abierta, aunque se use
# Orígenes extra desde los que se aceptan pedidos que modifican datos (además de WEB_URL), separados por coma.
# ORIGENES_PERMITIDOS=
# Cuántos proxies hay delante de la API (ej. 1 si hay solo HAProxy). De esto depende la IP de los topes por IP.
# TRUST_PROXY=1
# ENLACE_INICIO_MINUTOS=1440       # plazo para abrir el enlace del mail de inicio (24 h)
# Dirección de la botonera (apps/web): los mails apuntan acá. En producción, la dirección pública.
WEB_URL=http://localhost:5173

# --- Mail (códigos de verificación y avisos) ---
# consola: solo muestra los mails en el log (desarrollo). Sin esta variable se usa Gmail si está cargado, si no Microsoft Graph.
# MAIL_PROVIDER=consola
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=
MAIL_FROM_NOMBRE=Ministerio de Ecología de Misiones

# --- Fitosanitarios: avisos de vencimiento y emisión de prueba ---
# Avisos de vencimiento y limpieza: correr una vez por día desde el cron del servidor (usa este mismo .env):
#   npm run avisos
# Emisión SIMULADA (el pago real todavía no está implementado): con 1, POST /api/fitosanitarios/dev/emitir/<numero>
# emite el certificado de una solicitud aprobada. SOLO DESARROLLO: la API no arranca con esto activo en producción.
# EMISION_SIMULADA=1
